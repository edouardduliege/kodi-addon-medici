<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.audio.medici"
       name="Medici.tv"
       version="0.4.0"
       provider-name="Édouard Duliège">

    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.requests" version="2.31.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
               library="addon.py">
        <provides>audio video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">
            Browse and play Medici.tv concerts in audio or video
        </summary>

        <description lang="en_GB">
            Browse Medici.tv concerts, operas, ballets, documentaries,
            master classes and jazz, and play them as audio-only streams
            or audio+video.

            This is an unofficial community addon and is not affiliated with
            or endorsed by Medici.tv.
        </description>

        <platform>all</platform>
        <license>GPL-3.0-only</license>
    </extension>

</addon>
